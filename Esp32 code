// ==================================================================================
// ASYNCHRONOUS TELEGRAM SENDER (FreeRTOS Task - Non-blocking UI)
// ==================================================================================
void telegramTask(void *pvParameters) {
  String *msg = (String *)pvParameters;
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("[Telegram Task] Sending background notification...");
    WiFiClientSecure client;
    client.setInsecure();
    client.setTimeout(4);
    
    HTTPClient http;
    http.setTimeout(4000);
    
    String url = "https://api.telegram.org/bot" + BOT_TOKEN + "/sendMessage";
    
    if (http.begin(client, url)) {
      http.addHeader("Content-Type", "application/json");
      String jsonPayload = "{\"chat_id\":\"" + CHAT_ID + "\",\"text\":\"" + *msg + "\"}";
      int httpCode = http.POST(jsonPayload);
      Serial.printf("[Telegram Task] Response Code: %d\n", httpCode);
      http.end();
    }
  }
  
  delete msg;
  vTaskDelete(NULL);
}

void sendTelegramMessageAsync(String message) {
  if (!isWifiConnected) return;
  
  String *msgParam = new String(message);
  xTaskCreate(
    telegramTask,
    "TelegramTask",
    8192,
    (void *)msgParam,
    1,
    NULL
  );
}

// ==================================================================================
// HARDWARE WIFI EVENT LISTENER (SMART OTP RE-TRIGGER)
// ==================================================================================
void WiFiEvent(WiFiEvent_t event) {
  switch (event) {
    case ARDUINO_EVENT_WIFI_STA_GOT_IP:
      Serial.println("\n[Wi-Fi Event] Connected & Got IP!");
      if (!isWifiConnected) {
        isWifiConnected = true;
        onWifiStatusChanged();
      }
      break;

    case ARDUINO_EVENT_WIFI_STA_DISCONNECTED:
      if (isWifiConnected) { 
        Serial.println("\n[Wi-Fi Event] Connection lost!");
        isWifiConnected = false;
        onWifiStatusChanged();
      }
      break;
      
    default:
      break;
  }
}

// เมื่อ Wi-Fi เปลี่ยนสถานะกลางคัน
void onWifiStatusChanged() {
  Serial.printf("[Wi-Fi Status Shift] Now %s\n", isWifiConnected ? "ONLINE" : "OFFLINE");

  if (currentState == STATE_OTP) {
    drawOtpScreen();
    
    // หากสลับจาก Offline -> Online ขณะอยู่ Step 2 แล้วยังไม่ได้ส่ง OTP ให้ยิง Telegram ทันที
    if (isWifiConnected && !otpSentToTelegram && currentOtpCode.length() == 6) {
      Serial.println("[Wi-Fi Event] Reconnected in Step 2. Sending stored OTP to Telegram...");
      sendTelegramMessageAsync("🔑 Wi-Fi เชื่อมต่อสำเร็จ!\n\nรหัส 2FA OTP คือ: " + currentOtpCode);
      otpSentToTelegram = true;
    }
  } else if (currentState == STATE_PIN) {
    drawLockedScreen();
  } else if (currentState == STATE_WELCOME) {
    drawWelcomeScreen();
  } else if (currentState == STATE_UNLOCKED) {
    drawUnlockedScreen();
  }
}

// ==================================================================================
// SETUP & MAIN LOOP
// ==================================================================================
void setup() {
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0); 
  setCpuFrequencyMhz(160);

  Serial.begin(115200);
  delay(500);

  pinMode(TFT_BL_PIN, OUTPUT);
  digitalWrite(TFT_BL_PIN, HIGH); 

  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_CYAN, TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.drawString("CONNECTING WI-FI...", tft.width() / 2, 85, 4);

  WiFi.onEvent(WiFiEvent);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);
  WiFi.mode(WIFI_STA);
  WiFi.setTxPower(WIFI_POWER_13dBm);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int timeout = 0;
  while (WiFi.status() != WL_CONNECTED && timeout < 10) {
    delay(500);
    timeout++;
  }

  isWifiConnected = (WiFi.status() == WL_CONNECTED);

  if (isWifiConnected) {
    tft.fillScreen(TFT_BLACK);
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
    tft.drawString("WI-FI CONNECTED!", tft.width() / 2, 85, 4);
  } else {
    tft.fillScreen(TFT_BLACK);
    tft.setTextColor(TFT_YELLOW, TFT_BLACK);
    tft.drawString("OFFLINE MODE", tft.width() / 2, 85, 4);
  }
  delay(1000);

  Serial2.begin(115200, SERIAL_8N1, 16, -1);

  // เคลียร์ข้อมูลขยะตกค้างทางสาย UART
  while (Serial2.available() > 0) {
    Serial2.read();
  }

  currentState = STATE_WELCOME;
  drawWelcomeScreen();
}

void loop() {
  yield();

  if (Serial2.available() > 0) {
    char cmd = Serial2.read();
    Serial.printf("[UART Command]: '%c'\n", cmd);

    // WAKE UP LOGIC
    if (currentState == STATE_WELCOME) {
      if (cmd != 'L') {
        currentState = STATE_PIN;
        displayPin = "";
        drawLockedScreen();
        if ((cmd >= '0' && cmd <= '9') || (cmd >= 'A' && cmd <= 'F')) {
          currentChar = cmd;
          updateSelectorText();
        }
      }
      return; 
    }

    // 1. หมุนเลือกตัวเลข ('0'-'9', 'A'-'F')
    if ((cmd >= '0' && cmd <= '9') || (cmd >= 'A' && cmd <= 'F')) {
      currentChar = cmd;
      updateSelectorText();
    }
    // 2. กดปุ่มสั้น (Click = '+') -> เพิ่มตัวเลขขึ้นจอ
    else if (cmd == '+') {
      int maxLen = (currentState == STATE_OTP) ? 6 : 4;
      if (displayPin.length() < maxLen) {
        displayPin += currentChar;
        updatePinText();
      }
    }
    // 3. กดปุ่มปานกลาง (Mid = '-') -> ลบตัวเลขล่าสุด
    else if (cmd == '-') {
      if (displayPin.length() > 0) {
        displayPin.remove(displayPin.length() - 1);
        updatePinText();
      }
    }
    // 4. สลับสถานะระบบ
    else {
      switch (cmd) {
        case 'W': 
          currentState = STATE_PIN;
          displayPin = "";
          drawLockedScreen();
          break;

        case 'O': // Master PIN ถูกต้อง -> อ่านรหัส OTP 6 หลักจาก FPGA
          currentState = STATE_OTP;
          displayPin = "";
          currentOtpCode = "";
          otpSentToTelegram = false;
          drawOtpScreen();

          {
            unsigned long startMs = millis();
            
            while (currentOtpCode.length() < 6 && (millis() - startMs < 2000)) {
              if (Serial2.available() > 0) {
                char c = Serial2.read();
                if ((c >= '0' && c <= '9') || (c >= 'A' && c <= 'F')) {
                  currentOtpCode += c;
                }
              }
              delay(5);
            }
            
            Serial.println("[Received OTP Code from FPGA]: " + currentOtpCode);

            // หากมี Wi-Fi อยู่แล้ว ให้ส่งออก Telegram ทันที
            if (isWifiConnected && currentOtpCode.length() == 6) {
              sendTelegramMessageAsync("🔑 Master PIN ถูกต้อง!\n\nรหัส 2FA OTP คือ: " + currentOtpCode);
              otpSentToTelegram = true;
            }
          }
          break;

        case 'U': // Step 2 ผ่าน -> ปลดล็อกสำเร็จ
          currentState = STATE_UNLOCKED;
          currentOtpCode = "";
          otpSentToTelegram = false;
          drawUnlockedScreen();
          sendTelegramMessageAsync("🔓 ประตูปลดล็อกสำเร็จแล้ว!");
          break;

        case 'L': // ล็อกประตู / หมดเวลา Timeout -> สลับกลับหน้า Welcome
          if (currentState == STATE_UNLOCKED) {
            sendTelegramMessageAsync("🔒 ประตูล็อกอัตโนมัติเรียบร้อยแล้ว");
          }
          currentState = STATE_WELCOME;
          displayPin = "";
          currentOtpCode = "";
          otpSentToTelegram = false;
          drawWelcomeScreen();
          break;

        case 'e': // Master PIN ผิด
          currentState = STATE_DENIED;
          currentOtpCode = "";
          otpSentToTelegram = false;
          drawAccessDeniedScreen();
          sendTelegramMessageAsync("⚠️ ใส่ Master PIN ผิด!");
          delay(2000);
          currentState = STATE_WELCOME;
          displayPin = "";
          drawWelcomeScreen();
          break;

        case 'f': // Step 2 (OTP หรือ DE321A) ผิด
          currentState = STATE_DENIED;
          currentOtpCode = "";
          otpSentToTelegram = false;
          drawAccessDeniedScreen();
          sendTelegramMessageAsync("⚠️ ใส่ Step 2 PIN / OTP ผิด!");
          delay(2000);
          currentState = STATE_WELCOME;
          displayPin = "";
          drawWelcomeScreen();
          break;
      }
    }
  }
}

