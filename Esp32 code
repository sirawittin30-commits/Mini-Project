void updatePinText() {
  int centerX = tft.width() / 2;

  tft.fillRect(centerX - 110, 82, 220, 35, TFT_DARKGREY);
  tft.drawRect(centerX - 110, 82, 220, 35, TFT_WHITE);

  int totalDigits = (currentState == STATE_OTP) ? 6 : 4;
  String formattedPin = "";

  for (int i = 0; i < totalDigits; i++) {
    if (i < displayPin.length()) {
      formattedPin += String(displayPin[i]) + " ";
    } else {
      formattedPin += "_ ";
    }
  }

  tft.setTextColor(TFT_YELLOW, TFT_DARKGREY);
  tft.setTextDatum(MC_DATUM);
  tft.drawString(formattedPin, centerX, 99, 4);
}

